# Auto detect text files and perform LF normalization
* text=auto

# Source files
*.py text eol=lf diff=python
*.spec text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Scripts
*.bat text eol=crlf
*.ps1 text eol=crlf

# Images
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary

# Archives
*.zip binary
*.7z binary
*.tar binary
*.gz binary

# Executables
*.exe binary
*.dll binary
*.so binary
*.dylib binary

