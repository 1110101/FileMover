#!/bin/sh
# Husky commit-msg hook: Enforce Conventional Commits

commit_msg_file="$1"
commit_msg=$(head -n 1 "$commit_msg_file")

pattern="^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-zA-Z0-9_\.\-]+\))?: .+"

if ! echo "$commit_msg" | grep -Eq "$pattern"; then
    echo ""
    echo "ERROR: Invalid commit message format."
    echo "Commit message must follow Conventional Commits, for example:"
    echo "  feat: add retry mechanism for locked files"
    echo "  fix: resolve multi-rule observer override"
    echo "  docs: update development notes"
    echo "  test: add integration test for browser downloads"
    echo ""
    echo "Your message was: '$commit_msg'"
    echo ""
    exit 1
fi
